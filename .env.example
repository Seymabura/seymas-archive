# Bu dosyanın bir kopyasını ".env.local" adıyla oluştur ve değerleri Supabase panelinden doldur.
# Supabase > Project Settings > API sayfasında bulunur.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=buraya-anon-public-key

# Sitenin yayındaki adresi (Vercel'e koyduktan sonra). X paylaşım kartları için gerekli.
NEXT_PUBLIC_SITE_URL=https://seymas-archive.vercel.app

# X (Twitter) kullanıcı adın, @ olmadan. Sitede "X'te takip et" bağlantısı olarak görünür.
NEXT_PUBLIC_X_HANDLE=
